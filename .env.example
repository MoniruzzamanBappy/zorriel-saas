# Root domain the platform runs on. Shops live at <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN=zorriel.localhost
# App role (no superuser, no BYPASSRLS) used by the API at runtime
DATABASE_URL=postgres://zorriel_app:change-me@localhost:5432/zorriel
# Owner role used only for migrations
DATABASE_ADMIN_URL=postgres://zorriel_owner:change-me@localhost:5432/zorriel
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_URL=http://localhost:4000
